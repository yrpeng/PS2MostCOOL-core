{
    pcb_to_air
    {
		type	zeroGradient;
	}
    pcb_to_cpu1
    {
		type	zeroGradient;
	}
    pcb_to_cpu2
    {
		type	zeroGradient;
	}
    pcb_to_gpu1
    {
		type	zeroGradient;
	}
    pcb_to_gpu2
    {
		type	zeroGradient;
	}
    pcb_to_psu1
    {
		type	zeroGradient;
	}
    pcb_to_psu2
    {
		type	zeroGradient;
	}
    
}